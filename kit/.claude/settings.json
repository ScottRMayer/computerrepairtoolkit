{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "PowerShell(*Format-Volume*)",
      "PowerShell(format *)",
      "PowerShell(*format.com*)",
      "PowerShell(*/c format *)",
      "PowerShell(*/k format *)",
      "PowerShell(*-MethodName Format*)",
      "PowerShell(*Win32_Volume*Format*)",
      "PowerShell(*diskpart*)",
      "PowerShell(*Clear-Disk*)",
      "PowerShell(*Initialize-Disk*)",
      "PowerShell(*Remove-Partition*)",
      "PowerShell(*Set-Partition*IsActive*)",

      "PowerShell(*vssadmin*delete*)",
      "PowerShell(*wbadmin*delete*)",
      "PowerShell(*Disable-ComputerRestore*)",
      "PowerShell(*cipher*/w*)",

      "PowerShell(*manage-bde*-forcerecovery*)",
      "PowerShell(*manage-bde*-off*)",
      "PowerShell(*Disable-BitLocker*)",
      "PowerShell(*sdelete*)",
      "PowerShell(*Remove-LocalUser*)",
      "PowerShell(*net user*/delete*)",

      "PowerShell(*reg delete HKLM /f*)",
      "PowerShell(*reg delete HKLM\\SYSTEM /f*)",
      "PowerShell(*reg delete HKLM\\SOFTWARE /f*)",
      "PowerShell(*Remove-Item*HKLM:\\*)",

      "PowerShell(*Remove-Item*C:\\Windows*)",
      "PowerShell(*Remove-Item*C:\\Program Files*)",
      "PowerShell(*Remove-Item*$env:SystemRoot*)",
      "PowerShell(*Remove-Item*C:\\ *)",

      "Bash(*Format-Volume*)",
      "Bash(format *)",
      "Bash(*format.com*)",
      "Bash(*/c format *)",
      "Bash(*/k format *)",
      "Bash(*-MethodName Format*)",
      "Bash(*Win32_Volume*Format*)",
      "Bash(*diskpart*)",
      "Bash(*Clear-Disk*)",
      "Bash(*Initialize-Disk*)",
      "Bash(*Remove-Partition*)",
      "Bash(*Set-Partition*IsActive*)",

      "Bash(*vssadmin*delete*)",
      "Bash(*wbadmin*delete*)",
      "Bash(*Disable-ComputerRestore*)",
      "Bash(*cipher*/w*)",

      "Bash(*manage-bde*-forcerecovery*)",
      "Bash(*manage-bde*-off*)",
      "Bash(*Disable-BitLocker*)",
      "Bash(*sdelete*)",
      "Bash(*Remove-LocalUser*)",
      "Bash(*net user*/delete*)",

      "Bash(*reg delete HKLM /f*)",
      "Bash(*reg delete HKLM\\SYSTEM /f*)",
      "Bash(*reg delete HKLM\\SOFTWARE /f*)",
      "Bash(*Remove-Item*HKLM:\\*)",

      "Bash(*Remove-Item*C:\\Windows*)",
      "Bash(*Remove-Item*C:\\Program Files*)",
      "Bash(*Remove-Item*$env:SystemRoot*)",
      "Bash(*rm -rf /c/Windows*)",
      "Bash(*rm -rf C:/Windows*)",

      "Edit(C:\\Windows\\**)",
      "Edit(C:\\Program Files\\**)",
      "Edit(C:\\Program Files (x86)\\**)"
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "autoUpdatesChannel": "stable"
}
